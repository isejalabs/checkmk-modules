#!/usr/bin/env python3
"""Checkmk special agent: per-node, per-disk capacity and health of a Longhorn deployment.

Queries one Longhorn API endpoint (the environment's existing Longhorn UI route, which proxies `/v1/*` to the
backend) and writes the section `longhorn_capacity`: one JSON object per line, one per disk, or a single object
reporting the whole request failed if `/v1/nodes` could not be read at all. The Longhorn API has no
authentication of its own, so there is no secret to resolve here.
"""

import sys

from cmk.special_agents.v0_unstable.agent_common import SectionWriter, special_agent_main
from cmk.special_agents.v0_unstable.argument_parsing import Args, create_default_argument_parser

from cmk_addons.plugins.longhorn_capacity.lib.client import fetch_node_disks


def parse_arguments(argv: list[str] | None) -> Args:
    parser = create_default_argument_parser(description=__doc__)
    parser.add_argument(
        "--endpoint",
        required=True,
        help="Longhorn base URL, for example http://longhorn.dev.iseja.net (the existing UI route)",
    )
    parser.add_argument("--timeout", type=float, default=10.0, help="Request timeout in seconds (default: 10)")
    return parser.parse_args(argv)


def agent_main(args: Args) -> int:
    readings = fetch_node_disks(args.endpoint, timeout=args.timeout)
    with SectionWriter("longhorn_capacity") as writer:
        for reading in readings:
            writer.append(reading.to_json())
    return 0


def main() -> int:
    return special_agent_main(parse_arguments, agent_main)


if __name__ == "__main__":
    sys.exit(main())
