{'author': 'isejalabs',
 'description': 'Special agent and check plug-ins for Longhorn disk capacity and health. The agent reads the '
                'Longhorn CRDs through the Kubernetes API with a read-only ServiceAccount token (or, legacy, '
                'the unauthenticated /v1/nodes API through the Longhorn UI route). The checks show, per node '
                'and disk, physical usage, Longhorn\'s own scheduled/allocated usage kept as a separate '
                'service, and a disk/node health service, through the filesystem rules for the two capacity '
                'services; from the Kubernetes API also faulted, degraded and stuck volumes and instance '
                'managers that are not running.',
 'download_url': 'https://github.com/isejalabs/checkmk-modules',
 'files': {'cmk_addons_plugins': ['longhorn_capacity/agent_based/longhorn_capacity.py',
                                   'longhorn_capacity/agent_based/longhorn_resources.py',
                                   'longhorn_capacity/lib/__init__.py',
                                   'longhorn_capacity/lib/client.py',
                                   'longhorn_capacity/libexec/agent_longhorn_capacity',
                                   'longhorn_capacity/rulesets/special_agent.py',
                                   'longhorn_capacity/server_side_calls/special_agent.py']},
 'name': 'longhorn_capacity',
 'title': 'Longhorn disk capacity',
 'version': '0.2.0',
 'version.min_required': '2.4.0',
 'version.packaged': 'cmk-mkp-tool 1.0.0',
 'version.usable_until': None}
